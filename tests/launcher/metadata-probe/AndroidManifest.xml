<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.zettabridge.test.metadata">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <application android:name=".Probe$App" android:label="ZB Metadata Probe"
        android:allowBackup="false" android:theme="@android:style/Theme.Material.Light">
        <provider android:name=".Probe$Startup" android:authorities="org.zettabridge.test.metadata.startup"
            android:exported="false" />
        <service android:name=".Probe$MarkerService" android:exported="false">
            <meta-data android:name="org.zettabridge.test.MARKER" android:value="manifest-ok" />
        </service>
        <activity android:name=".Probe" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
